.btn-file-warn { font-weight: bold; font-family: "Arial, sans-serif"; color: rgb(255, 255, 255); background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; padding: 0px 7px; margin: 7px 0px; }

.btn-file-warn .tooltip { position: absolute; background-color: rgba(16, 16, 16, 0.6); color: white; border-radius: 3px; font-family: sans-serif; padding: 5px; margin: 18px 0px 0px; font-weight: 300; font-size: 0.9em; z-index: 2147483647; display: none; box-shadow: rgba(0, 0, 0, 0.2) 3px 3px 3px; }

.btn-file-warn:hover .tooltip { display: block; }

.file-warn-download { position: absolute; width: 100%; background: rgb(252, 252, 255); top: 40px; left: 0px; border-radius: 0px 0px 6px 6px; box-shadow: rgba(0, 0, 0, 0.1) 0px 6px 10px 0px; padding: 20px; }

#downloadDocument button { height: 50px; min-width: 133px; margin-left: 2%; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 3px; background: rgb(128, 150, 168); color: white; float: right; margin-top: 4px; margin-right: 2px; cursor: pointer; font-weight: bold; font-family: Lato, sans-serif; font-size: inherit; text-align: center; padding: 15px; text-decoration: none; transition: 0.2s; display: flex; align-items: center; }

#downloadDocument button:hover { background: rgb(162, 187, 208); box-shadow: rgb(202, 152, 4) 0px 0px 2px 0px; color: rgb(234, 240, 250); user-select: none; }

#downloadDocument button:active { background: rgb(131, 159, 183); color: white; }

#downloadDocument div { margin-bottom: 15px; }

#downloadDocument button.download { background: rgb(7, 112, 163); }

#downloadDocument button[disabled] { pointer-events: none; cursor: wait; background-color: gray; }

.text_warning i { padding-right: 5px; margin-top: 3px; }

@media screen and (min-width: 1024px) {
  .modal-content { width: 680px; }
}

@media screen and (max-width: 1024px) {
  .modal-title { font-size: 1em; }
  .modal-body { font-size: 0.9em; }
  .modal-footer { font-size: 0.85em; }
  .close { font-size: 20px; }
}

@media screen and (max-width: 630px) {
  .text_warning { font-size: 12px; }
}

.annotationTextContent { display: none; }
